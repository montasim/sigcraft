# Sigcraft environment variables
#
# Copy this file to `.env` (or `.env.local`) and change the values you need:
#   cp .env.example .env
# `.env` files are git-ignored; only this example is committed.
# Sigcraft has no secrets, so everything here is safe to share.
#
# On Netlify, set the same names under:
#   Site configuration → Environment variables

# ---------------------------------------------------------------------------
# VITE_SITE_URL (optional)
#
# The public address where Sigcraft is deployed, with no trailing slash.
# Copied signatures load the photo and icons from
#   <VITE_SITE_URL>/images/signature/...
# because Gmail can't store images inside a pasted signature.
#
# Default when unset: https://sigcraft.netlify.app
# Set it only if the site lives somewhere else (a custom domain, or a
# different Netlify site name). It is read at build time, so redeploy after
# changing it.
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://sigcraft.netlify.app
