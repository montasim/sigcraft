# Sigcraft environment variables
#
# Reference only: names and example values. Real values live in Infisical
# (the project linked by .infisical.yaml), in the `dev` environment for
# local work and `prod` for the deployed site. Don't copy this file to
# .env; Vite's .env loading is turned off.
#
#   pnpm dev       fetches `dev` with `infisical run`
#   Netlify build  reads the site's environment variables, kept in step
#                  with Infisical's `prod` environment
#
# Sigcraft has no secrets, so everything here is safe to share.

# ---------------------------------------------------------------------------
# VITE_SITE_URL (optional)
#
# The public address where Sigcraft is deployed, with no trailing slash.
# Copied signatures load the photo and icons from
#   <VITE_SITE_URL>/images/signature/...
# because Gmail can't store images inside a pasted signature.
#
# Default when unset: https://sigcraft.netlify.app
# It is read at build time, so redeploy after changing it.
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://sigcraft.netlify.app
